    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Standardize the text output from the different parsers\nlet text = \"\";\nif ($json.data) text = $json.data;\nelse if ($json.text) text = $json.text;\nelse text = JSON.stringify($json);\n\n// 2. Fetch the filename from the Search node\nlet filename = $('Search files and folders2').item.json.name || \"\";\n\n// 3. Determine if this is the SI or BL file based on the filename\nlet docType = filename.includes(\"SI\") ? \"SI\" : \"BL\";\n\n// 4. Extract the email_id directly from the filename (e.g., email_004_SI.txt -> email_004)\nlet emailId = filename.split(\"_SI\")[0].split(\"_BL\")[0];\n\nreturn { \n  email_id: emailId,\n  document_type: docType,\n  filename: filename,\n  document_text: text\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        -304
      ],
      "id": "93281508-2a6a-43f6-8c4c-3651641e40b5",
      "name": "Normalize & Tag Data"
