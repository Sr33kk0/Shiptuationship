    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Safely parse the JSON string from the LLM's 'text' output\nlet extractedData = {};\ntry {\n  extractedData = JSON.parse($json.text);\n} catch (error) {\n  // Fallback just in case the parser already converted it to an object\n  extractedData = $json; \n}\n\n// 2. Re-attach the email_id and doc_type using the correct node name\nreturn {\n  email_id: $('Normalize & Tag Data').item.json.email_id,\n  document_type: $('Normalize & Tag Data').item.json.document_type,\n  extracted_fields: extractedData\n};"
      },
