    {
      "parameters": {
        "jsCode": "let result = [];\n\nfor (let item of $input.all()) {\n  let data = item.json;\n  let emailId = data.email_id;\n  let fields = data.extracted_fields || {};\n  \n  if (data.document_type === \"BL\") {\n    result.push({\n      json: {\n        \"_routing_tag\": \"BL\",\n        \"Email No.\": emailId,\n        \"BL Shipper \": fields.shipper || \"\",\n        \"BL Consignee\": fields.consignee || \"\",\n        \"BL Notify Party\": fields.notify_party || \"\",\n        \"BL Port of Loading\": fields.port_of_loading || \"\",\n        \"Bl Port of Discharge\": fields.port_of_discharge || \"\",\n        \"BL Container Count\": fields.container_count || \"\",\n        \"BL Gross Weight (KG)\": fields.gross_weight_kg || \"\"\n      }\n    });\n  } else if (data.document_type === \"SI\") {\n    result.push({\n      json: {\n        \"_routing_tag\": \"SI\",\n        \"Email No.\": emailId,\n        \"SI Shipper \": fields.shipper || \"\",\n        \"SI Consignee\": fields.consignee || \"\",\n        \"SI Notify Party\": fields.notify_party || \"\",\n        \"SI Port of Loading\": fields.port_of_loading || \"\",\n        \"SI Port of Discharge\": fields.port_of_discharge || \"\",\n        \"SI Container Count\": fields.container_count || \"\",\n        \"SI Gross Weight (KG)\": fields.gross_weight_kg || \"\"\n      }\n    });\n  }\n}\n\nreturn result;"
      },
