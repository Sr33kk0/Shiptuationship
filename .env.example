# Google OAuth2 client (same one n8n's Firestore credential uses is fine)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token granted with scope https://www.googleapis.com/auth/datastore
GOOGLE_REFRESH_TOKEN=
FIRESTORE_PROJECT_ID=hokkien

# Production webhook URL from the active n8n auto-reply workflow
N8N_AUTO_REPLY_WEBHOOK_URL=http://localhost:5678/webhook/generate-auto-reply
